from langchain_core.output_parsers import PydanticOutputParser
from pydantic import BaseModel, Field
from langchain_core.prompts import PromptTemplate
from dotenv import load_dotenv
from typing import List
from matplotlib import pyplot as plt
from langchain_openai import ChatOpenAI
import time
import re
import pandas as pd
import os
import sys
import torch
from shap_e.diffusion.sample import sample_latents
from shap_e.diffusion.gaussian_diffusion import diffusion_from_config
from shap_e.models.download import load_model, load_config
from shap_e.util.notebooks import decode_latent_mesh
from collections import OrderedDict

script_start = time.time()
load_dotenv()

model = ChatOpenAI(model="gpt-4o")

class SetCoord(BaseModel):
    name: str = Field(description="name of the object")
    description: str = Field(description="Your description must include outlook that is relevant to the place. You should mention the place in description. Don't include other objects, just a single object.Mention that this has simple features. You don't have to mention where it is in the place")
    X_coordinate: float = Field(description="X coordinate of the object within given scale of a grid")
    Y_coordinate: float = Field(description="Y coordinate of the object within given scale of a grid")

class SetCoords(BaseModel):
    objects: List[SetCoord] = Field(description="List of objects with their names and coordinates")

parser = PydanticOutputParser(pydantic_object=SetCoords)
format_instructions = parser.get_format_instructions()

prompt = PromptTemplate(
    template=(
        "You are an interior designer.\n"
        "You know where the furniture must be placed.\n"
        "{format_instructions}\n"
        "User Query: {query}\n"
        "Please set the variety of furniture evenly spread placed in the given scale of 2D grid.Avoid placing objects along a single diagonal line such as x=y.\n"
        "Doors should be included.\n"
        "Please respond with multiple instances of common furniture (such as desks and chairs) if they typically occur "
        "several times in a given place environment. The maximum number of same objects is 20. Include various other given place items as well, making sure each "
        "object has unique coordinates within a given scale of a grid. Provide the response strictly in JSON format.\n"
        "Please spread the furniture and doors evenly across the space, assigning unique names, coordinates, and a detailed description for each object.\n"
        "After generating the furniture layout, please review and revise it if necessary, and check if the objects are placed only diagonally. Then return the final corrected JSON."
    ),
    input_variables=["query"],
    partial_variables={"format_instructions": format_instructions},
)

chain = prompt | model

def extract_room_scale(query_text):
    match = re.search(r'(\d+)\s*\*\s*(\d+)', query_text)
    if match:
        width = int(match.group(1))
        height = int(match.group(2))
        return width, height
    else:
        return 100, 100

def safe_model_invoke(query):
    output = chain.invoke({"query": query})
    try:
        parsed_output = parser.invoke(output)
        return parsed_output
    except Exception as e:
        print(f"\u26a0\ufe0f 모델 응답을 처리하는데 문제가 발생했습니다: {e}")
        print("\u26a0\ufe0f 모델 원본 응답:", output)
        return None

query_text = ("I have provided you a grid space with scale of 30 * 30 representing a formal inside of a school. Please set the objects of the room ")
parsed_output = safe_model_invoke(query_text)

if parsed_output is not None:
    block_start = time.time()

    object_names = [obj.name for obj in parsed_output.objects]
    object_descriptions = [obj.description for obj in parsed_output.objects]
    x_coords = [obj.X_coordinate for obj in parsed_output.objects]
    y_coords = [obj.Y_coordinate for obj in parsed_output.objects]

    room_width, room_height = extract_room_scale(query_text)

    df = pd.DataFrame({
        'name': object_names,
        'x': x_coords,
        'y': y_coords
    })

    os.makedirs("objs", exist_ok=True)
    output_image_path = "objs/object_placement_plot.png"

    plt.figure(figsize=(10, 10))
    plt.scatter(df['x'], df['y'], s=100, color='blue')
    for i in range(len(df)):
        plt.text(df['x'][i] + 0.5, df['y'][i] + 0.5, df['name'][i], fontsize=9, ha='left', va='bottom')
    plt.title("Object Placement from GPT Output")
    plt.xlabel("X Coordinate")
    plt.ylabel("Y Coordinate")
    plt.xlim(0, room_width)
    plt.ylim(0, room_height)
    plt.grid(True, linestyle="--", alpha=0.5)
    plt.tight_layout()
    plt.savefig(output_image_path, dpi=300)
    block_end = time.time()
    print(f"\u2705 그래프 이미지 저장 완료: {output_image_path}")

device = torch.device('cuda:6' if torch.cuda.is_available() else 'cpu')
xm = load_model('transmitter', device=device)
shap_e_model = load_model('text300M', device=device)
diffusion = diffusion_from_config(load_config('diffusion'))

def normalize_name(name):
    return re.sub(r'\d+$', '', name)

name_description_map = OrderedDict()
for name, description in zip(object_names, object_descriptions):
    norm_name = normalize_name(name)
    if norm_name not in name_description_map:
        name_description_map[norm_name] = description

normalized_names = list(name_description_map.keys())
normalized_descriptions = list(name_description_map.values())

for i in range(len(normalized_descriptions)):
    name = normalized_names[i]
    prompt = normalized_descriptions[i]
    print(f"Generating for: {name}")
    latents = sample_latents(
        batch_size=1,
        model=shap_e_model,
        diffusion=diffusion,
        guidance_scale=15.0,
        model_kwargs=dict(texts=[prompt]),
        progress=True,
        clip_denoised=True,
        use_fp16=True,
        use_karras=True,
        karras_steps=64,
        sigma_min=1e-3,
        sigma_max=160,
        s_churn=0,
    )
    for latent in latents:
        t = decode_latent_mesh(xm, latents).tri_mesh()
        with open(f'objs/{name}.obj', 'w') as f:
            t.write_obj(f)

def parse_obj(file_path):
    with open(file_path, 'r') as f:
        lines = f.readlines()
    vertices = []
    faces = []
    z_min = float('inf')
    for line in lines:
        if line.startswith('v '):
            parts = line.strip().split()
            z = float(parts[3])
            z_min = min(z_min, z)
            vertices.append(line.strip())
        elif line.startswith('f '):
            faces.append(line.strip())
    return vertices, faces, z_min

def translate_vertices(vertices, x_offset, y_offset, z_offset=0.0):
    translated = []
    for v in vertices:
        parts = v.split()
        x, y, z = map(float, parts[1:4])
        x += x_offset
        y += y_offset
        z += z_offset
        translated.append(f"v {x:.6f} {y:.6f} {z:.6f}")
    return translated

def shift_face_indices(faces, offset):
    shifted = []
    for face in faces:
        parts = face.split()
        new_indices = []
        for p in parts[1:]:
            idx_parts = p.split('/')
            idx_parts[0] = str(int(idx_parts[0]) + offset)
            new_indices.append('/'.join(idx_parts))
        shifted.append('f ' + ' '.join(new_indices))
    return shifted

def generate_floor_and_walls(room_width, room_height, wall_height=10.0):
    vertices = []
    faces = []
    floor_verts = [(0, 0, 0), (room_width, 0, 0), (room_width, room_height, 0), (0, room_height, 0)]
    vertices.extend(floor_verts)
    faces.append((1, 2, 3))
    faces.append((1, 3, 4))
    v_offset = len(vertices)
    for wall in [
        [(0, 0, 0), (room_width, 0, 0), (room_width, 0, wall_height), (0, 0, wall_height)],
        [(0, room_height, 0), (room_width, room_height, 0), (room_width, room_height, wall_height), (0, room_height, wall_height)],
        [(0, 0, 0), (0, room_height, 0), (0, room_height, wall_height), (0, 0, wall_height)],
        [(room_width, 0, 0), (room_width, room_height, 0), (room_width, room_height, wall_height), (room_width, 0, wall_height)],
    ]:
        vertices.extend(wall)
        faces.append((v_offset + 1, v_offset + 2, v_offset + 3))
        faces.append((v_offset + 1, v_offset + 3, v_offset + 4))
        v_offset += 4
    obj_vertices = [f"v {x:.2f} {y:.2f} {z:.2f}" for x, y, z in vertices]
    obj_faces = [f"f {a} {b} {c}" for a, b, c in faces]
    return obj_vertices, obj_faces

def merge_objs(base_path, object_names, x_coords, y_coords, room_width, room_height, output_path="merged.obj"):
    all_vertices = []
    all_faces = []
    floor_wall_vertices, floor_wall_faces = generate_floor_and_walls(room_width, room_height)
    all_vertices.extend(floor_wall_vertices)
    all_faces.extend(floor_wall_faces)
    vertex_offset = len(floor_wall_vertices)
    for i, obj_name in enumerate(object_names):
        norm_name = normalize_name(obj_name)
        obj_path = os.path.join(base_path, f"{norm_name}.obj")
        if not os.path.isfile(obj_path):
            print(f"\u274c Missing OBJ file: {obj_path}")
            continue
        vertices, faces, z_min = parse_obj(obj_path)
        z_offset = abs(z_min) if z_min < 0 else 0.0
        translated = translate_vertices(vertices, x_coords[i], y_coords[i], z_offset)
        shifted_faces = shift_face_indices(faces, vertex_offset)
        all_vertices.extend(translated)
        all_faces.extend(shifted_faces)
        vertex_offset += len(vertices)
    with open(output_path, 'w') as f:
        f.write('\n'.join(all_vertices + all_faces))
    print(f"\u2705 Merged .obj written to: {output_path}")

merge_objs(
    base_path='./objs',
    object_names=object_names,
    x_coords=x_coords,
    y_coords=y_coords,
    room_width=room_width,
    room_height=room_height,
    output_path='./objs/output.obj'
)

script_end = time.time()
print(f"\n🕒 전체 실행 시간: {script_end - script_start:.2f}초".encode('utf-8', errors='ignore').decode('utf-8'))

